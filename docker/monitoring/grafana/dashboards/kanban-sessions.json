{
  "uid": "kanban-sessions",
  "title": "Канбан · очистка сессий",
  "description": "Доступность API и состояние периодической очистки просроченных сессий.",
  "tags": [
    "kanban",
    "cron"
  ],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Доступность API",
      "description": "Blackbox Exporter проверяет HTTP 200 и status=ok на /health.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Недоступно",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Доступно",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "probe_success{job=\"kanban-health\"}",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Секунд с последней очистки",
      "description": "Cron запускает очистку каждую минуту. Значение выше 150 секунд участвует в правиле KanbanSessionCleanupStalled.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        }
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "kanban_session_cleanup_age_seconds{job=\"kanban\"}",
          "legendFormat": "Возраст",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Просроченные сессии в PostgreSQL",
      "description": "Если cron остановлен, просроченные записи остаются в таблице sessions.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        }
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "kanban_expired_sessions{job=\"kanban\"}",
          "legendFormat": "Просрочено",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Удалено сессий за 5 минут",
      "description": "Прирост счётчика успешной очистки за скользящие 5 минут.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0
        }
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "increase(kanban_session_cleanup_deleted_total{job=\"kanban\"}[5m])",
          "legendFormat": "Удалено",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    }
  ]
}
